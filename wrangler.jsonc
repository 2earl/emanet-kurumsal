{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emanet-kurumsal",
  // The 2earl Cloudflare account. An identifier, not a credential; deploys need only the token.
  "account_id": "304c2b77d734c688c8309d5a535f561a",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Webhook deliveries go only to public addresses; the language engine uses AsyncLocalStorage.
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_als"],

  // Served at https://kurumsal.emanet.dev: the custom domain is 2earl/emanet-core's
  // infra/worker.tf, attached once this Worker exists.
  "workers_dev": false,
  "preview_urls": false,

  // Logs, traces and Issues in Cloudflare (emanet-core docs/DESIGN.md §12). The app logs one
  // structured line per request: route pattern, status, duration. Never a plate, an address or a
  // person; invocation logs (full URLs) stay off.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
    "issues": { "enabled": true },
  },

  "vars": {
    "SITE_ORIGIN": "https://kurumsal.emanet.dev",
    "AUTHORIZATION_SERVER": "https://login.2earl.com",
  },

  // Set by the deploy workflow from the GitHub `production` environment.
  "secrets": {
    "required": [
      // HMAC key for session and sign-in cookies and for API keys (only HMACs are stored).
      "SESSION_PEPPER",
      // AES-GCM key (base64, 32 bytes) that encrypts webhook signing secrets at rest.
      "WEBHOOK_KEY",
    ],
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },

  "services": [
    // Token exchange and validation for sign-in, never over the public Internet.
    { "binding": "AUTH_SERVER", "service": "login" },
    // Which organizations a person belongs to, and their role in each (login DESIGN §4.14).
    { "binding": "ORGS", "service": "login", "entrypoint": "OrganizationDirectory" },
    // Creates an invited company's organization (docs/DESIGN.md §5, Onboarding).
    { "binding": "ORG_PROVISIONING", "service": "login", "entrypoint": "OrganizationProvisioning" },
    // What each person may do here: their role's permissions and any role the organization
    // gave them (login docs/AUTHORIZATION.md). Answers only about Emanet's own permissions.
    {
      "binding": "AUTHZ",
      "service": "login",
      "entrypoint": "Authorization",
      "props": { "service": "emanet" },
    },
    // Emanet's data and rules: this app may only do what a creditor may (emanet-core).
    { "binding": "CORE", "service": "emanet-core", "entrypoint": "PartnerApi" },
  ],

  // Per network for sign-in and forms; per API key for the API.
  "ratelimits": [
    {
      "name": "FORM_RATE_LIMITER",
      "namespace_id": "2001",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "2002",
      "simple": { "limit": 300, "period": 60 },
    },
  ],

  // Onboarding documents (signature circular, tax certificate, ...), in the EU like the rest.
  "r2_buckets": [
    { "binding": "DOCUMENTS", "bucket_name": "emanet-documents", "jurisdiction": "eu" },
    // Custody documents of a delivered case, read only, streamed to that case's partner.
    { "binding": "EVIDENCE", "bucket_name": "emanet-evidence", "jurisdiction": "eu" },
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emanet-kurumsal",
      "database_id": "1567b5c9-9f77-45be-a12c-80eec38bc20b",
      "migrations_dir": "migrations",
    },
  ],

  // Every minute: deliver webhooks (src/webhooks.ts).
  "triggers": {
    "crons": ["* * * * *"],
  },
}
